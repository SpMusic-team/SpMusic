<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/pref_aa_bg_options" android:summary="@string/pref_summary_aa_bg_options"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:z="http://schemas.android.com/apk/res-auto" xmlns:w="http://schemas.android.com/apk/res-auto">
    <com.maxmpz.audioplayer.preference.MultilineSwitchPreference android:title="@string/pref_text_aa_bg_options" android:key="aa_blur_enabled" />
    <com.maxmpz.audioplayer.preference.MultilineSwitchPreference android:title="@string/pref_list_aa_blur_enabled" android:key="list_aa_blur_enabled" android:dependency="aa_blur_enabled" />
    <com.maxmpz.audioplayer.preference.MultilineSwitchPreference android:title="@string/pref_lyrics_aa_blur_enabled" android:key="lyrics_aa_blur_enabled" android:dependency="aa_blur_enabled" />
    <com.maxmpz.audioplayer.preference.RawTextPreference android:background="@drawable/settings_quote_background" w:line1="@string/pref_aa_bg_skins_hint" w:line2="@string/pref_lyrics_lust_bg_dimmed_hint" w:keepPaddings="true" />
    <com.maxmpz.audioplayer.preference.SeekbarPreference android:title="@string/aa_bg_gradient" android:key="aa_bg_gradient" android:summary="@string/_d" w:max="10" w:min="0" w:leftLabel="@string/none" w:rightLabel="@string/maximum_short" w:tickMark="@drawable/pref_seekbar_tickmark" />
    <com.maxmpz.audioplayer.preference.ColorPreference android:title="@string/aa_bg_gradient_color" android:key="aa_bg_gradient_color" android:summary="%s" />
    <com.maxmpz.audioplayer.preference.MultilineSwitchPreference android:title="@string/aa_bg_gradient_for_list" android:key="aa_bg_gradient_for_list" android:summary="@string/summary_aa_bg_gradient_for_list" />
    <com.maxmpz.audioplayer.preference.RawTextPreference w:line1="@string/skin_may_override_option" w:zeroTopPad="true" />
    <com.maxmpz.audioplayer.preference.SeekbarPreference android:title="@string/pref_aa_blur" android:key="aa_blur" android:summary="@string/_d" android:dependency="aa_blur_enabled" android:defaultValue="5" w:max="15" w:min="0" w:leftLabel="@string/pref_aa_blur_less" w:rightLabel="@string/pref_aa_blur_more" w:tickMark="@drawable/pref_seekbar_tickmark" />
    <com.maxmpz.audioplayer.preference.SeekbarPreference android:title="@string/pref_aa_blur_scale" android:key="aa_blur_scale" android:summary="@string/_d" android:dependency="aa_blur_enabled" android:defaultValue="5" w:max="10" w:min="0" w:leftLabel="@string/pref_aa_blur_scale_less" w:rightLabel="@string/pref_aa_blur_scale_more" w:tickMark="@drawable/pref_seekbar_tickmark" />
    <com.maxmpz.audioplayer.preference.SeekbarPreference android:title="@string/pref_aa_blur_intensity" android:key="aa_blur_intensity" android:summary="@string/d_percent" android:dependency="aa_blur_enabled" android:defaultValue="100" w:max="250" w:min="0" />
    <com.maxmpz.audioplayer.preference.RawTextPreference w:smallLine1="@string/pref_aa_blur_intensity_hint" />
    <com.maxmpz.audioplayer.preference.SeekbarPreference android:title="@string/pref_aa_blur_saturation" android:key="aa_blur_saturation" android:summary="@string/d_percent" android:dependency="aa_blur_enabled" android:defaultValue="150" w:max="300" w:min="0" w:step="10" />
    <com.maxmpz.audioplayer.preference.RawTextPreference w:smallLine1="@string/pref_aa_blur_intensity_hint" />
    <Preference android:title="@string/pref_restore_defaults" android:key="restore_defaults" />
</PreferenceScreen>
