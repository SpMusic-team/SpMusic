<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/pref_look_and_feel"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:z="http://schemas.android.com/apk/res-auto" xmlns:w="http://schemas.android.com/apk/res-auto">
    <com.maxmpz.audioplayer.preference.RedirectPreference android:title="@string/pref_skin" android:key="ui_theme" android:summary="@string/pref_summary_skin" w:target="ui_theme" />
    <com.maxmpz.audioplayer.preference.MultilineSwitchPreference android:persistent="true" android:title="@string/pref_follow_night_mode" android:key="follow_night_mode" android:summary="@string/pref_summary_follow_night_mode" android:defaultValue="false" />
    <com.maxmpz.audioplayer.preference.TagListPreference android:title="@string/pref_settings_theme" android:key="settings_theme" android:defaultValue="0" w:entries="@array/pref_settings_theme_labels" />
    <com.maxmpz.audioplayer.preference.TagListPreference android:title="@string/pref_settings_font" android:key="settings_font" android:defaultValue="2" w:entries="@array/pref_settings_font_labels" />
    <PreferenceCategory android:title="@string/pref_general">
        <com.maxmpz.audioplayer.preference.RedirectPreference android:title="@string/pref_player_ui" android:key="ui_player" w:target="ui_player" />
        <com.maxmpz.audioplayer.preference.RedirectPreference android:title="@string/lyrics" android:key="ui_lyrics" w:target="ui_lyrics" />
        <com.maxmpz.audioplayer.preference.RedirectPreference android:title="@string/pref_notifications" android:key="ui_notify" w:target="ui_notify" />
        <com.maxmpz.audioplayer.preference.RedirectPreference android:summary="@string/pref_see_more_ui_prefs_in_lists" w:target="library_lists" w:skipSearch="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_misc">
        <com.maxmpz.audioplayer.preference.ListPreference android:persistent="true" android:entries="@array/pref_language_entries" android:title="@string/pref_language" android:key="lang" android:summary="%s" android:defaultValue="" android:dialogTitle="@string/pref_language" android:entryValues="@array/pref_language_values" />
        <com.maxmpz.audioplayer.preference.RedirectPreference android:title="@string/pref_icon" android:key="ui_icon" android:summary="@string/pref_summary_icon" w:target="ui_icon" />
        <com.maxmpz.audioplayer.preference.TagListPreference android:title="@string/pref_orientation" android:key="orientation" android:defaultValue="0" w:entries="@array/pref_orientation_entries" />
        <com.maxmpz.audioplayer.preference.TagListPreference android:title="@string/animations" android:key="anim_speed" android:summary="@string/summary_anim_speed" android:defaultValue="false" w:entries="@array/anim_speed_entries" w:values="@array/anim_speed_values" w:featurePack="1" />
        <com.maxmpz.audioplayer.preference.MultilineSwitchPreference android:title="@string/pref_start_at_lib" android:key="start_at_lib" android:summary="@string/pref_summary_startup_screen" android:defaultValue="false" />
        <com.maxmpz.audioplayer.preference.MultilineSwitchPreference android:persistent="true" android:title="@string/pref_hide_status_bar" android:key="hide_status_bar" android:defaultValue="false" />
        <com.maxmpz.audioplayer.preference.RawTextPreference android:background="@drawable/settings_quote_background" w:line1="@string/skin_navbar_firmware_warn" w:skipSearch="true" w:keepPaddings="true" />
        <com.maxmpz.audioplayer.preference.MultilineSwitchPreference android:title="@string/pref_keep_screen_on" android:key="keep_screen_on" android:summary="@string/pref_summary_keep_screen_on" />
        <com.maxmpz.audioplayer.preference.SeekbarPreference android:title="@string/num_settings_tags" android:key="num_settings_tags" android:summary="%s" w:entries="@array/zero_index_disabled_entries" w:max="10" w:min="0" w:leftLabel="@string/disabled" w:rightLabel="@string/maximum_short" w:tickMark="@drawable/pref_seekbar_tickmark" />
        <Preference android:title="@string/pref_restore_defaults" android:key="restore_defaults" />
    </PreferenceCategory>
</PreferenceScreen>
